{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "traiinc-cms-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-31",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "traiinc-cms",
      "database_id": "REPLACE_WITH_CLOUDFLARE_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ADMIN_ORIGIN": "https://admin.traiinc.com",
    "CF_ACCESS_TEAM_DOMAIN": "REPLACE_WITH_YOUR_TEAM.cloudflareaccess.com"
  }
  // Worker Secret: CF_ACCESS_AUD (set via `wrangler secret put CF_ACCESS_AUD` or CI secret; do not commit)
}
